# {{ ansible_managed }}
apiVersion: cilium.io/v2
kind: CiliumLoadBalancerIPPool
metadata:
  name: lan
spec:
  blocks:
    - start: "{{ k8s_lb_pool_start }}"
      stop: "{{ k8s_lb_pool_stop }}"
---
apiVersion: cilium.io/v2alpha1
kind: CiliumL2AnnouncementPolicy
metadata:
  name: lan
spec:
  # Answer ARP for LoadBalancer/external IPs on the node's LAN NIC.
  interfaces:
    - ^(eth|en)[a-z0-9]+
  loadBalancerIPs: true
  externalIPs: true
