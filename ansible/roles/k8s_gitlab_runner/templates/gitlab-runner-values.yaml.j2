# {{ ansible_managed }}
gitlabUrl: {{ k8s_gitlab_runner_gitlab_url }}/
concurrent: {{ k8s_gitlab_runner_concurrent }}
checkInterval: 10

rbac:
  create: true

resources:
  requests: {cpu: 50m, memory: 64Mi}
  limits: {memory: 256Mi}

runners:
  # Holds runner-token (glrt-...). Created by scripts/register-runner.sh,
  # never by Ansible, so the token isn't in this repo or on the control node.
  secret: gitlab-runner-token
  config: |
    [[runners]]
      clone_url = "{{ k8s_gitlab_runner_gitlab_url }}"
      [runners.kubernetes]
        namespace = "{{ k8s_gitlab_runner_namespace }}"
        image = "alpine:3.22"
        cpu_request = "200m"
        memory_request = "256Mi"
        memory_limit = "2Gi"
        helper_cpu_request = "50m"
        helper_memory_request = "64Mi"
        service_cpu_request = "50m"
        service_memory_request = "64Mi"
