# {{ ansible_managed }}
# Small single-instance Argo CD for a 3-node lab.
dex:
  enabled: false           # local admin only; no SSO in the lab
notifications:
  enabled: false
server:
  service:
    type: LoadBalancer     # UI on a LAN IP from the Cilium pool (self-signed TLS)
    annotations:
      lbipam.cilium.io/ips: "{{ k8s_argocd_ui_ip }}"   # pinned: stable across rebuilds
configs:
  cm:
    # Re-check git every minute; the default is 3.
    timeout.reconciliation: 60s
