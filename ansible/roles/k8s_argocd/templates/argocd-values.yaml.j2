# {{ ansible_managed }}
# Small single-instance Argo CD for a 3-node lab.
dex:
  enabled: false           # local admin only; no SSO in the lab
notifications:
  enabled: false
server:
  service:
    type: LoadBalancer     # UI on a LAN IP from the Cilium pool (self-signed TLS)
    annotations:
      lbipam.cilium.io/ips: "{{ k8s_argocd_ui_ip }}"   # pinned: stable across rebuilds
configs:
  cm:
    # Re-check git every minute; the default is 3.
    timeout.reconciliation: 60s
    # Slinky's NodeSet reports readiness in its status, but Argo CD doesn't know
    # the CRD and would call it Healthy the moment it's applied (seen on a fresh
    # rebuild: "Healthy" ~30 s before any slurmd pod existed). Judge it by pods.
    resource.customizations.health.slinky.slurm.net_NodeSet: |
      local hs = {status = "Progressing", message = "waiting for slurmd pods"}
      if obj.status ~= nil then
        local want = obj.status.desired or (obj.spec ~= nil and obj.spec.replicas) or 0
        local ready = obj.status.readyReplicas or 0
        hs.message = ready .. "/" .. want .. " slurmd pods ready"
        if want > 0 and ready >= want then
          hs.status = "Healthy"
        end
      end
      return hs
