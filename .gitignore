# Terraform
terraform/.terraform/
terraform/*.tfstate
terraform/*.tfstate.*
terraform/terraform.tfvars
terraform/crash.log
terraform/.terraform.tfstate.lock.info

# Generated from Terraform state
ansible/inventory/hosts.yml

# Generated secrets (slurmdbd DB password, etc.). Never commit.
ansible/.secrets/

# Go build output
triage/bin/

*.retry
.venv/

# ansible-lint cache
.ansible/

# Drill run logs (terraform/ansible output) and captured fixtures; the JSON results are kept
drills/results/*.log
drills/results/*_fixtures/
drills/results/*.tfvars.json
drills/__pycache__/
