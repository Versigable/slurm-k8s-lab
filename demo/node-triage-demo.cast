[30.671, "o", "i"]
[30.692, "o", "s"]
[30.712, "o", "k"]
[30.733, "o", " "]
[30.754, "o", "f"]
[30.774, "o", "a"]
[30.794, "o", "u"]
[30.815, "o", "l"]
[30.835, "o", "t"]
[30.856, "o", "."]
[30.877, "o", " "]
[30.898, "o", "I"]
[30.919, "o", " "]
[30.94, "o", "a"]
[30.961, "o", "p"]
[30.982, "o", "p"]
