[45.831, "o", "NODELIST STATE REASON\r\nslinky-0 drained slurm-operator: (FilesystemIsReadOnly: EXT4-fs (vda1): Remounting filesystem read-only)\r\nslinky-1 idle none\r\n"]
[48.831, "o", "\r\n"]
[48.831, "o", "\u001b[1m4. Try to put it back\u001b[0m\r\n"]
