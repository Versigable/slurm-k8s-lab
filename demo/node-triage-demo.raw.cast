[0.0, "o", "\u001b[1mnode-triage demo\u001b[0m  \u001b[2mClaude Code + a Go MCP server on a real 3-node Slurm lab\u001b[0m\r\n"]
[0.001, "o", "\u001b[2mClaude has only the slurm-triage tools: no shell, no files. SKILL.md is its playbook.\u001b[0m\r\n"]
[0.001, "o", "\r\n"]
[0.001, "o", "\u001b[1m1. A GPU falls off the bus on slurm-c1\u001b[0m \u001b[2m(slurmd now finds 3 of 4 GPUs)\u001b[0m\r\n"]
