[30.752, "o", "l"]
[30.772, "o", "t"]
[30.793, "o", "."]
[30.814, "o", " "]
[30.835, "o", "I"]
[30.856, "o", " "]
[30.877, "o", "a"]
[30.898, "o", "p"]
[30.919, "o", "p"]
